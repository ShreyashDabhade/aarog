# Example environment variables for this project.
# DO NOT store real secrets in this file in a public repo.

# Secret key used by backend for JWT signing. Must be a long, random string.
SECRET_KEY=change_this_to_a_secure_random_string

# Google API key for Gemini/LLM usage
GOOGLE_API_KEY=your-google-api-key-here

# Celery broker (Redis) connection string - example:
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional: path to Chroma DB and server private key (do not commit real key)
CHROMA_DB_DIR=data/chroma
SERVER_PRIV_KEY_PATH=docs/server_privkey.pem
